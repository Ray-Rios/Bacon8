{
  "repository": {},
  "description": " ",
  "license": "MIT",
  "dependencies": {
    "morphdom": "^2.7.0",
    "quill": "^2.0.3",
    "quill-cursors": "^4.0.3",
    "three": "^0.170.0",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.20"
  },
  "scripts": {
    "prebuild": "node ./scripts/gen-plugin-hooks.js && node ./scripts/check-no-css-imports.js",
    "prebuild:js": "node ./scripts/gen-plugin-hooks.js",
    "prewatch:js": "node ./scripts/gen-plugin-hooks.js",
    "pretype-check": "node ./scripts/gen-plugin-hooks.js",
    "build": "npm run update-browserslist && npm run build:css && npm run build:js",
    "build:css": "echo 'Building Tailwind CSS with PostCSS...' && npx postcss -c postcss.config.js css/app.css -o ../priv/static/assets/app.css --env production && echo 'PostCSS/Tailwind build complete. Size:' && wc -c ../priv/static/assets/app.css",
    "build:js": "esbuild js/app.ts --bundle --outdir=../priv/static/assets --external:/fonts/* --external:/images/* --external:*.css --format=iife --target=es2020 --minify --sourcemap --tree-shaking=true --loader:.ts=ts --define:global=window --define:LV_VSN='\"1.0.18\"'",
    "copy:quill-css": "echo 'postcss-import will handle quill.css now; no-op'",
    "deploy": "npm run build && npm run copy:fonts",
    "copy:fonts": "mkdir -p ../priv/static/fonts && cp -r fonts/* ../priv/static/fonts/",
    "update-browserslist": "npx update-browserslist-db@latest",
    "watch": "npm run watch:css & npm run watch:js",
    "watch:css": "tailwindcss -c tailwind.config.js -i css/app.css -o ../priv/static/assets/app.css --watch",
    "watch:js": "esbuild js/app.ts --bundle --outdir=../priv/static/assets --external:/fonts/* --external:/images/* --watch --format=iife --target=es2020 --loader:.ts=ts --define:global=window",
    "type-check": "tsc --noEmit",
    "lint:ts": "eslint js/**/*.ts",
    "stylelint": "stylelint 'css/**/*.css' --allow-empty-input",
    "type-check:watch": "tsc --noEmit --watch",
    "lint": "npm run lint:ts && npm run stylelint",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "lint:fix": "eslint js/**/*.ts --fix && npx stylelint 'css/**/*.css' --fix",
    "dev": "npm run type-check & npm run watch"
  },
  "devDependencies": {
    "@eslint/config-array": "^0.18.0",
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.46.1",
    "@tailwindcss/forms": "^0.5.9",
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "eslint": "^9.12.0",
    "playwright": "^1.46.1",
    "postcss": "^8.4.47",
    "postcss-cli": "^10.1.0",
    "postcss-import": "^15.0.0",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.6.0"
  }
}
