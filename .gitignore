# Sensitive configuration files
k3s/overlays/prod/ingress.yaml
k3s/overlays/prod/mailhog-auth-secret.yaml
k3s/overlays/prod/secrets.yaml
k3s/overlays/dev/secrets.yaml
backups/
OpenWorldEngine/
# Database files
*.db
*.sql
*.sqlite
*.sqlite3

# Generated secrets
priv/cert/
priv/static/models/
priv/static/maps/*
# The Dockerfile copies this folder, so a fresh clone needs it to exist.
!priv/static/maps/.gitkeep
priv/static/uploads/
uploads/

# Logs
*.log
logs/
log/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Editor directories and files
.kiro
.vs
.vscode/
.claude/
# Phoenix artifacts
/_build/
/deps/
priv/static/assets/
/assets/node_modules/
# Generated by assets/scripts/gen-plugin-hooks.js on every JS build
assets/js/plugins.generated.ts
priv/static/cache_manifest.json

# Avoid accidentally committing compiled bundles
app.js

# Temporary files
tmp/
temp/

# Docker
# .dockerignore is tracked on purpose: it is what keeps a private plugin's
# .git, k3s/ (with its secrets file) and scripts out of `COPY plugins`.
docker-compose.override.yml

# SSL certificates (if storing locally)
*.key
*.crt
*.pem
*.p12
*.pfx

# Backup files
*.backup
*.bak
*.tmp

# Additional security - API keys and tokens
*.env.*
# A missing newline had fused this negation with the `uploads/` rule below
# ("!.env.exampleuploads/"), so uploads/ was never actually ignored. Nothing
# had been committed from it yet, so this is a fix rather than a cleanup.
!.env.example

# User uploads — runtime data, synced separately via sync-uploads-*.sh
uploads/

# ============================================================
# Private plugins (BACON8.md §9)
#
# Only the plugins that ship with the hub are tracked. Any other folder in
# plugins/ is someone's own plugin, usually its own git repository, and must
# never be committed here (it would also turn into a gitlink: a submodule
# pointer with no .gitmodules, which clones as an empty directory).
# ============================================================
/plugins/*
!/plugins/README.md
!/plugins/bacon_world/
!/plugins/bacon_store/

# A game's own repository checked out at the root for tooling (its plugin's
# build scripts look for it there). Same gitlink reason as above.
#
# THE LEADING SLASH IS LOAD-BEARING: unanchored, and with core.ignorecase on
# Windows, it would also match any same-named directory deeper in the tree.
/RaysSpaceSim/

# Shared source-asset library (Substance .sbsar and the like): licensed files we may use
# but never redistribute. Lives here for every game; only baked outputs ship. See library/README.md.
/library/
